# Variables used by docker-compose.yml. Copy to `.env` and fill in. Never commit `.env`.
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Optional: password for the demo users created by `npm run db:seed`
SEED_USER_PASSWORD=
