# Copy this file to `.env` and fill in the values. Never commit `.env`.
NODE_ENV=development
PORT=4000

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://kanban:change-me@localhost:5432/kanban
# Used only by the test suite (it is migrated and truncated on every run)
TEST_DATABASE_URL=postgres://kanban:change-me@localhost:5432/kanban_test

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Frontend origin allowed by CORS / Socket.IO
CLIENT_ORIGIN=http://localhost:5173
# Set to true behind HTTPS so the refresh cookie gets the Secure flag
COOKIE_SECURE=false

# Password assigned to the demo users created by `npm run db:seed`.
# If empty, a random one is generated and printed to the console.
SEED_USER_PASSWORD=
